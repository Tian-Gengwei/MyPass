{
  "manifest_version": 2,
  "name": "MyPass Password Manager",
  "version": "0.1.0",
  "description": "Local-first, end-to-end encrypted password manager",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "MyPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mypass@mypass.app",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    "icons/*"
  ]
}
