{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPass",
  "version": "0.1.0",
  "identifier": "com.mypass.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "MyPass",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first password manager",
    "longDescription": "MyPass is a local-first, cross-platform, end-to-end encrypted password manager with self-developed storage format, manifest-driven sync, and browser extension auto-fill.",
    "icon": [
      "icons/icon.ico"
    ]
  }
}